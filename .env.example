# Copy to .env and fill in. Never commit .env.

# Leave empty to use a local SQLite file (farmnex_routes_dev.db) for testing.
# For Supabase use the same connection string as the main backend
# (Dashboard -> Connect -> Session pooler), e.g.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Create rt_* tables automatically on first request (never touches other tables).
ROUTES_AUTO_CREATE_TABLES=true

# osrm = real road distances from the free public OSRM server; haversine = offline estimate.
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

# Tuning (defaults shown)
SERVICE_MINUTES_PER_STOP=15
POOL_RADIUS_KM=30
POOL_DROP_RADIUS_KM=40
MAX_LOADS_PER_TRIP=4
BACKHAUL_RADIUS_KM=30
NEW_LOAD_NOTIFY_RADIUS_KM=25
AVG_TRUCK_SPEED_KMPH=35

# Placeholder fares, Rs per km
RATE_PICKUP=18
RATE_TEMPO=22
RATE_MINI_TRUCK=28
RATE_TRUCK=38
RATE_REEFER=50
